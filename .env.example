DATABASE_URL="file:./dev.db"
# Supabase is prepared as a separate target. Keep DATABASE_URL on SQLite until
# the migration has been validated, then follow README.md#supabase.
# SUPABASE_DATABASE_URL="postgresql://..." # runtime/session-pooler URL
# SUPABASE_DIRECT_URL="postgresql://..."   # direct URL used for schema/migration
# After activation, DATABASE_URL and DIRECT_URL become the two runtime/migration URLs.
# DIRECT_URL="postgresql://..."
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SECRET_KEY="sb_secret_..."       # backend only; never commit or expose
# SUPABASE_STORAGE_BUCKET="product-images"
# PRODUCT_IMAGE_MAX_BYTES=5242880
JWT_SECRET="change-me-in-production"
PORT=3333
HOST="127.0.0.1"
FRESH_STOCK_TTL_HOURS=6
PROCESSED_STOCK_TTL_HOURS=72
REQUEST_HOLD_HOURS=24
PAYMENT_WEBHOOK_SECRET="change-me-too"
# The complete archive includes these files. Paths may be absolute or project-relative.
WELILINK_FRONTEND_PATH="frontend/welilink-web-home.html"
WELILINK_LOGO_PATH="assets/welilink-logo.jpeg"
# Optional: enables Weli's Gemini-powered conversational mode. Keep the key server-side only.
# GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT_MS=12000
GEMINI_MAX_OUTPUT_TOKENS=220
# Maximum number of messages accepted per visitor or signed-in user during the window below.
ASSISTANT_RATE_LIMIT_MAX=8
ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
