{
  "name": "welilink-market-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "vercel-build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:supabase:validate": "prisma validate --schema prisma/schema.supabase.prisma",
    "db:supabase:generate": "prisma generate --schema prisma/schema.supabase.prisma",
    "db:supabase:push": "prisma db push --schema prisma/schema.supabase.prisma",
    "db:migrate:supabase": "tsx scripts/migrate-sqlite-to-supabase.ts",
    "db:associate-images": "tsx scripts/associate-local-product-images.ts",
    "db:activate:supabase": "powershell -ExecutionPolicy Bypass -File scripts/activate-supabase.ps1",
    "db:restore:sqlite": "powershell -ExecutionPolicy Bypass -File scripts/restore-sqlite.ps1",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@fastify/jwt": "9.0.1",
    "@fastify/multipart": "^9.4.0",
    "@google/genai": "^2.30.0",
    "@prisma/client": "6.16.2",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "3.0.2",
    "dotenv": "^18.0.8",
    "fastify": "5.2.1",
    "pg": "^8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/pg": "^8.23.1",
    "prisma": "6.16.2",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
